# Copia este archivo como .env para configurar la API en local.
# Si no defines nada, se usa SQLite (focus.db).

# --- Azure SQL Database (opción 1: variables separadas, recomendado) ---
# AZURE_SQL_SERVER=focus-sql-luisbb27.database.windows.net
# AZURE_SQL_DB=focusdb
# AZURE_SQL_USER=focusadmin
# AZURE_SQL_PASSWORD=TuContrasena123!
# AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# --- Opción 2: URL completa de SQLAlchemy ---
# DATABASE_URL=sqlite:///./focus.db

# --- Azure Blob Storage (fotos de perfil) ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=fotos
# AZURE_STORAGE_PUBLICO=false

# --- CORS (orígenes separados por coma) ---
# CORS_ORIGINS=*

# --- Compañero IA (Foqui con Claude) ---
# Sin llave, Foqui responde con mensajes predefinidos.
# ANTHROPIC_API_KEY=sk-ant-...
# COMPANERO_MODELO=claude-haiku-5-5

# --- Zona horaria de los usuarios para los modelos de IA (la BD guarda UTC) ---
# UTC_OFFSET_HORAS=-6
